# afrirates-api environment variables
# Copy this file to .env and fill in your values

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/afrirates"

# Redis
REDIS_URL="redis://localhost:6379"

# Scraper
SCRAPER_INTERVAL_MINUTES=15
AFRIRATES_BASE_URL="https://afrirates.com"

# Webhooks
WEBHOOK_SECRET="change-me-to-a-random-secret"

# App
NODE_ENV="development"
PORT=3000
